<UserControl x:Class="Mirrorly.Desktop.Views.BackupSetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="{StaticResource MirrorlySectionSpacing}" MaxWidth="{StaticResource MirrorlyContentMaxWidth}" HorizontalAlignment="Stretch">
  <StackPanel Spacing="{StaticResource MirrorlyTextSpacing}">
   <TextBlock Text="Set up backup" Style="{StaticResource MirrorlyPageTitle}" />
   <TextBlock x:Name="StepText" Text="Step 1 of 2 · Choose folders" Style="{StaticResource MirrorlySecondary}" />
   <TextBlock Text="Set up a repository and configuration. Files are backed up in a later step." Style="{StaticResource MirrorlyCaption}" />
  </StackPanel>
  <StackPanel x:Name="ChooseStep" Spacing="{StaticResource MirrorlyCardSpacing}">
   <TextBlock Text="Choose one folder to back up and one backup location. Select a folder, or double-click to open it. Click the address to type a path." Style="{StaticResource MirrorlyBody}" />
   <Grid x:Name="Panes" ColumnSpacing="{StaticResource MirrorlyCardSpacing}" RowSpacing="{StaticResource MirrorlyCardSpacing}">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   </Grid>
   <Border Style="{StaticResource MirrorlyCard}" Background="{ThemeResource MirrorlySurfaceSubtleBrush}">
    <StackPanel Spacing="{StaticResource MirrorlyControlSpacing}">
     <TextBlock Text="Your selection" Style="{StaticResource MirrorlySectionTitle}" />
     <TextBlock Text="Source" Style="{StaticResource MirrorlyCaption}" />
     <TextBlock Text="{Binding Source.SelectionText}" Style="{StaticResource MirrorlyPath}" ToolTipService.ToolTip="{Binding Source.SelectionText}" />
     <TextBlock Text="Backup location" Style="{StaticResource MirrorlyCaption}" />
     <TextBlock Text="{Binding Destination.SelectionText}" Style="{StaticResource MirrorlyPath}" ToolTipService.ToolTip="{Binding Destination.SelectionText}" />
     <TextBlock Text="Backup will be stored in:" Style="{StaticResource MirrorlyCaption}" />
     <TextBlock Text="{Binding RepositoryPreview}" Style="{StaticResource MirrorlyPath}" ToolTipService.ToolTip="{Binding RepositoryPreview}" />
    </StackPanel>
   </Border>
   <InfoBar x:Name="SamePathNotice" Severity="Warning" IsClosable="False" Title="The same folder is selected on both sides"
     Message="Choose a different backup location. Mirrorly will check setup when you review." />
   <Button x:Name="ContinueButton" Content="Continue" IsEnabled="{Binding CanContinue}" Click="Continue_Click" Style="{StaticResource MirrorlyPrimaryButton}" />
  </StackPanel>
  <StackPanel x:Name="ReviewStep" Visibility="Collapsed" Spacing="{StaticResource MirrorlyCardSpacing}">
   <Border Style="{StaticResource MirrorlyCard}">
    <StackPanel Spacing="{StaticResource MirrorlyCardSpacing}">
     <TextBlock Text="Review backup" Style="{StaticResource MirrorlySectionTitle}" />
     <TextBox x:Name="NameInput" Header="Backup name" IsEnabled="{Binding CanEdit}" Text="{Binding BackupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
     <TextBlock x:Name="NameHint" Text="Enter a name for this backup." Style="{StaticResource MirrorlySecondary}" Visibility="Collapsed" />
     <TextBlock Text="Folder to back up" Style="{StaticResource MirrorlyCaption}" />
     <TextBlock Text="{Binding Source.SelectedPath}" Style="{StaticResource MirrorlyBody}" IsTextSelectionEnabled="True" />
     <TextBlock Text="Backup location" Style="{StaticResource MirrorlyCaption}" />
     <TextBlock Text="{Binding Destination.SelectedPath}" Style="{StaticResource MirrorlyBody}" IsTextSelectionEnabled="True" />
     <TextBlock Text="Mirrorly repository · Checked by Mirrorly" Style="{StaticResource MirrorlyCaption}" />
     <TextBlock Text="{Binding RepositoryPreview}" Style="{StaticResource MirrorlyBody}" IsTextSelectionEnabled="True" />
     <TextBlock Text="Backups are stored as ordinary files that you can browse with File Explorer." Style="{StaticResource MirrorlyBody}" />
     <TextBlock Text="Create checks these details again before making changes." Style="{StaticResource MirrorlyCaption}" />
    </StackPanel>
   </Border>
   <StackPanel Orientation="Horizontal" Spacing="{StaticResource MirrorlyControlSpacing}">
    <Button Content="Back" IsEnabled="{Binding CanEdit}" Click="Back_Click" Style="{StaticResource MirrorlySecondaryButton}" />
    <Button Content="Check again" IsEnabled="{Binding CanCheck}" Click="Check_Click" Style="{StaticResource MirrorlySecondaryButton}" />
    <Button Content="Create backup" IsEnabled="{Binding CanCreate}" Click="Create_Click" Style="{StaticResource MirrorlyPrimaryButton}" />
   </StackPanel>
   <InfoBar x:Name="SetupNotice" Severity="Informational" IsClosable="False" Title="Setup status" Message="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
   <Expander Header="View technical details" HorizontalAlignment="Stretch"><TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander>
   <Button Content="Return Home" Click="Return_Click" Style="{StaticResource MirrorlySecondaryButton}" />
  </StackPanel>
 </StackPanel>
</UserControl>
