<UserControl x:Class="Mirrorly.Desktop.Views.BackupsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="{StaticResource MirrorlySectionSpacing}" MaxWidth="{StaticResource MirrorlyContentMaxWidth}" HorizontalAlignment="Stretch">
  <StackPanel Spacing="{StaticResource MirrorlyTextSpacing}">
   <TextBlock Text="Backups" Style="{StaticResource MirrorlyPageTitle}"/>
   <TextBlock Text="Your configured backups" Style="{StaticResource MirrorlySecondary}"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" Spacing="{StaticResource MirrorlyControlSpacing}">
   <Button x:Name="SetupAction" Content="Set up backup" Click="Setup_Click" Style="{StaticResource MirrorlySecondaryButton}"/>
   <Button x:Name="RefreshAction" Content="Refresh" Click="Refresh_Click" Style="{StaticResource MirrorlySecondaryButton}"/>
  </StackPanel>
  <TextBlock x:Name="CatalogState" Style="{StaticResource MirrorlyBody}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="ProblemText" Text="{Binding Problem}" Style="{StaticResource MirrorlyBody}" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
  <Expander x:Name="TechnicalPanel" Header="View technical details" Visibility="Collapsed">
   <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  </Expander>
  <InfoBar x:Name="OpenNotice" Title="Saved backup unavailable" Severity="Informational" IsClosable="True" IsOpen="False" Visibility="Collapsed"/>
  <StackPanel x:Name="Backups" Spacing="{StaticResource MirrorlyControlSpacing}"/>
 </StackPanel>
</UserControl>
