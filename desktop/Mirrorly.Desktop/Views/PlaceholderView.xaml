<UserControl x:Class="Mirrorly.Desktop.Views.PlaceholderView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="{StaticResource MirrorlySectionSpacing}">
  <TextBlock x:Name="Heading" Style="{StaticResource MirrorlyPageTitle}"/>
  <Border Style="{StaticResource MirrorlyCard}">
   <StackPanel Spacing="{StaticResource MirrorlyControlSpacing}">
    <TextBlock Text="A little more to come" Style="{StaticResource MirrorlySectionTitle}"/>
    <TextBlock Text="This page will be implemented in a later phase." Style="{StaticResource MirrorlyBody}"/>
    <TextBlock Text="Phase 1B is a visual preview. No backup settings or files are changed." Style="{StaticResource MirrorlySecondary}"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
