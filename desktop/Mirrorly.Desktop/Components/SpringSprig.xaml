<UserControl x:Class="Mirrorly.Desktop.Components.SpringSprig" x:Name="Placement"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" Visibility="{ThemeResource MirrorlyDecorationVisibility}">
 <UserControl.Resources>
  <Storyboard x:Key="PetalFlourish" FillBehavior="Stop">
   <DoubleAnimation Storyboard.TargetName="PetalOne" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" From="0" To="13" Duration="0:0:0.38" />
   <DoubleAnimation Storyboard.TargetName="PetalTwo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" From="0" To="10" Duration="0:0:0.38" />
   <DoubleAnimation Storyboard.TargetName="PetalOne" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" From="0" To="18" Duration="0:0:0.38" />
   <DoubleAnimation Storyboard.TargetName="PetalTwo" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)" From="0" To="-13" Duration="0:0:0.38" />
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetalOne" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.83"/>
    <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0.70"/><LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
   <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetalTwo" Storyboard.TargetProperty="Opacity">
    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.09" Value="0.74"/>
    <LinearDoubleKeyFrame KeyTime="0:0:0.29" Value="0.62"/><LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
   </DoubleAnimationUsingKeyFrames>
  </Storyboard>
 </UserControl.Resources>
 <!-- Canvas measures no intrinsic image size. The semantic placement style owns the slot. -->
 <Grid AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
  <Canvas><Image x:Name="Artwork" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" /></Canvas>
  <!-- Two tiny detached petals exist only during the admitted-start one-shot. SVG artwork remains unchanged. -->
  <Viewbox Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
   <Canvas Width="270" Height="280" AutomationProperties.AccessibilityView="Raw">
    <Path x:Name="PetalOne" Canvas.Left="119" Canvas.Top="100" Opacity="0" Fill="#F6B2C6"
     Data="M 0 0 C -5 -3 -7 -9 -3 -13 C 0 -16 5 -11 4 -7 C 4 -4 2 -1 0 0 Z">
     <Path.RenderTransform><CompositeTransform/></Path.RenderTransform>
    </Path>
    <Path x:Name="PetalTwo" Canvas.Left="161" Canvas.Top="182" Opacity="0" Fill="#F7C6D7"
     Data="M 0 0 C -4 -3 -5 -8 -2 -11 C 1 -13 5 -9 4 -5 C 3 -2 1 -1 0 0 Z">
     <Path.RenderTransform><CompositeTransform/></Path.RenderTransform>
    </Path>
   </Canvas>
  </Viewbox>
 </Grid>
</UserControl>
